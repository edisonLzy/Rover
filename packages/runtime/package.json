{
  "name": "@rover/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "build:sea": "node scripts/build-sea.mjs",
    "smoke:sea": "node scripts/smoke-sea.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e:m1": "pnpm typecheck:e2e && pnpm build && cargo build --quiet --manifest-path ../app/src-tauri/Cargo.toml --bin rover-hook-helper && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@trpc/server": "catalog:",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@trpc/client": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
