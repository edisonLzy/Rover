{
  "name": "@rover/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "tsc && vite build",
    "build:app": "pnpm --filter @rover/runtime build:sea && tauri build --config src-tauri/tauri.release.conf.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "package:mac:arm64": "tauri build --config src-tauri/tauri.release.conf.json --target aarch64-apple-darwin --bundles app",
    "package:mac:x64": "tauri build --config src-tauri/tauri.release.conf.json --target x86_64-apple-darwin --bundles app",
    "package:win": "tauri build --config src-tauri/tauri.release.conf.json --target x86_64-pc-windows-msvc",
    "package:win:x64": "tauri build --config src-tauri/tauri.release.conf.json --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@rover/runtime": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "lucide-react": "^1.49.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "catalog:",
    "vite": "^8.0.16",
    "vitest": "catalog:"
  }
}
